    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/testing": "11.1.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.35",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "prisma": "7.8.0",
